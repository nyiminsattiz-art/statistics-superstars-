    "import sys\n",
    "sys.path.append('..')\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "from src.data_loader import DataLoader\n",
    "from src.statistics import StatisticalAnalyzer\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Load cleaned data\n",
    "loader = DataLoader(data_dir=\"../data\")\n",
    "df = pd.read_csv(loader.processed_dir / \"cleaned_data.csv\")\n",
    "\n",
    "# Initialize analyzer\n",
    "analyzer = StatisticalAnalyzer(df)\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"HYPOTHESIS TESTING\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "all_tests = []\n",
    "\n",
    "# ==================== 1. T-TESTS ====================\n",
    "print(\"\\nT-TESTS\")\n",
    "\n",
    "# One-sample t-test: Is average sepal length significantly different from 5.5?\n",
    "result = analyzer.t_test('sepal length (cm)', 5.5)\n",
    "print(f\"\\nOne-sample t-test on sepal length (cm):\")\n",
    "print(f\"  Mean: {result['mean']:.3f}\")\n",
    "print(f\"  t-statistic: {result['statistic']:.3f}\")\n",
    "print(f\"  p-value: {result['p_value']:.4f}\")\n",
    "print(f\"  Significant: {result['significant']}\")\n",
    "print(f\"  Interpretation: {result['interpretation']}\")\n",
    "\n",
    "all_tests.append({\n",
    "    'test': 'One-sample t-test',\n",
    "    'variable': 'sepal length (cm)',\n",
    "    'statistic': result['statistic'],\n",
    "    'p_value': result['p_value'],\n",
    "    'significant': result['significant']\n",
    "})\n",
    "\n",
    "# Independent t-test: Compare petal length between two species\n",
    "species_names = df['species'].unique()\n",
    "group1, group2 = species_names[0], species_names[1]\n",
    "\n",
    "data1 = df[df['species'] == group1]['petal length (cm)'].dropna()\n",
    "data2 = df[df['species'] == group2]['petal length (cm)'].dropna()\n",
    "\n",
    "statistic, p_value = stats.ttest_ind(data1, data2)\n",
    "\n",
    "print(f\"\\nIndependent t-test: {group1} vs {group2}\")\n",
    "print(f\"  Mean {group1}: {data1.mean():.3f}\")\n",
    "print(f\"  Mean {group2}: {data2.mean():.3f}\")\n",
    "print(f\"  t-statistic: {statistic:.3f}\")\n",
    "print(f\"  p-value: {p_value:.4f}\")\n",
    "print(f\"  Significant: {p_value < 0.05}\")\n",
    "\n",
    "all_tests.append({\n",
    "    'test': 'Independent t-test',\n",
    "    'variable': f'petal length (cm): {group1} vs {group2}',\n",
    "    'statistic': statistic,\n",
    "    'p_value': p_value,\n",
    "    'significant': p_value < 0.05\n",
    "})\n",
    "\n",
    "# ==================== 2. ANOVA ====================\n",
    "print(\"\\nONE-WAY ANOVA\")\n",
    "\n",
    "groups = []\n",
    "for species in df['species'].unique():\n",
    "    groups.append(df[df['species'] == species]['petal length (cm)'].dropna())\n",
    "\n",
    "f_statistic, p_value = stats.f_oneway(*groups)\n",
    "\n",
    "print(f\"\\nANOVA: Petal Length by Species\")\n",
    "print(f\"  f-statistic: {f_statistic:.3f}\")\n",
    "print(f\"  p-value: {p_value:.4f}\")\n",
    "print(f\"  Significant: {p_value < 0.05}\")\n",
    "\n",
    "if p_value < 0.05:\n",
    "    print(\"  Interpretation: At least one species has significantly different petal length\")\n",
    "\n",
    "all_tests.append({\n",
    "    'test': 'One-way ANOVA',\n",
    "    'variable': 'petal length (cm) by species',\n",
    "    'statistic': f_statistic,\n",
    "    'p_value': p_value,\n",
    "    'significant': p_value < 0.05\n",
    "})\n",
    "\n",
    "# ==================== 3. CHI-SQUARE TEST ====================\n",
    "print(\"\\nCHI-SQUARE TEST\")\n",
    "print(\"Skipped: Iris dataset only has one categorical variable (species),\")\n",
    "print(\"chi-square needs two categorical variables to compare.\")\n",
    "\n",
    "# ==================== 4. SUMMARY OF ALL TESTS ====================\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"SUMMARY OF HYPOTHESIS TESTS\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "summary_df = pd.DataFrame(all_tests)\n",
    "summary_df.to_csv('../reports/hypothesis_tests_summary.csv', index=False)\n",
    "print(\"\\nHypothesis test results saved to 'reports/hypothesis_tests_summary.csv'\")\n",
    "print(summary_df.to_string())"
   ]
  }
